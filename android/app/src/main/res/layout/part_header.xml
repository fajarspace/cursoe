<?xml version="1.0" encoding="utf-8"?>
<!-- Header kaca melayang (seperti navbar web): transparan di atas, kaca + blur saat di-scroll. -->
<dev.cursoe.ui.GlassBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="24dp">

    <ImageButton
        android:id="@+id/header_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_menu"
        android:tint="@color/gb_text" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="@string/app_name"
        android:textColor="@color/gb_text"
        android:textSize="20sp"
        android:textStyle="bold" />
</dev.cursoe.ui.GlassBar>
